<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Rafix - Hepsi Bir Arada</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://unpkg.com/tesseract.js@v2.1.0/dist/tesseract.min.js"></script>

<style>
  :root { --cream: #F7F4EF; --dark: #1C1916; --accent: #C85A2A; --white: #FFFFFF; --ok: #2E7D52; --border: #E6E2D9; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--dark); padding: 20px; }
  
  /* Ana Arayüz */
  .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
  h1 { font-family: 'Playfair Display', serif; color: var(--accent); font-size: 32px; }
  
  .product-list { margin-top: 20px; }
  .card { background: var(--white); padding: 15px; border-radius: 16px; margin-bottom: 12px; border: 1.5px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  
  /* Butonlar */
  .btn-main { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); width: calc(100% - 40px); max-width: 400px; padding: 18px; background: var(--accent); color: white; border: none; border-radius: 40px; font-weight: 600; font-size: 16px; box-shadow: 0 10px 20px rgba(200,90,42,0.3); z-index: 100; }
  .btn-action { width: 100%; padding: 15px; background: var(--accent); color: white; border: none; border-radius: 30px; margin-top: 10px; font-weight: 600; }

  /* Modal (Tüm işlemler burada) */
  .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: none; z-index: 1000; flex-direction: column; justify-content: center; padding: 20px; }
  .modal-box { background: var(--white); border-radius: 24px; padding: 20px; width: 100%; max-width: 400px; margin: auto; }
  
  #reader { width: 100%; border-radius: 12px; overflow: hidden; }
  .crop-area { width: 100%; max-height: 350px; background: #000; border-radius: 12px; overflow: hidden; margin: 10px 0; }
  #img-to-crop { display: block; max-width: 100%; }
  
  .loader { display: none; text-align: center; color: var(--accent); margin: 10px; font-weight: bold; }
</style>
</head>
<body>

<div class="header">
  <h1>Rafix</h1>
  <span>Dolabım</span>
</div>

<div id="product-list" class="product-list">
  <p id="empty-msg" style="text-align: center; color: #888; margin-top: 50px;">Henüz ürün yok. Aşağıdaki butona basarak ekle.</p>
</div>

<button class="btn-main" onclick="openScanner()">+ Ürün Ekle</button>

<div class="modal-overlay" id="work-modal">
  <div class="modal-box">
    <h2 id="modal-title" style="margin-bottom: 15px; font-family: 'Playfair Display';">Barkod Tara</h2>
    
    <div id="step-barcode">
      <div id="reader"></div>
      <button class="btn-action" style="background:#666; margin-top:10px;" onclick="closeAll()">Vazgeç</button>
    </div>

    <div id="step-crop" style="display:none;">
      <div class="crop-area">
        <img id="img-to-crop">
      </div>
      <p style="font-size:12px; color:#666; text-align:center;">Tarihi kare içine al.</p>
      <button class="btn-action" onclick="finishOCR()">✂️ Tarihi Oku ve Kaydet</button>
    </div>

    <div id="loading" class="loader">Lütfen bekleyin...</div>
    
    <input type="file" id="take-photo" accept="image/*" capture="environment" style="display:none;">
  </div>
</div>

<script>
let html5QrCode;
let cropper;
let tempProduct = { name: "", barcode: "", date: "" };

function openScanner() {
  document.getElementById('work-modal').style.display = 'flex';
  document.getElementById('step-barcode').style.display = 'block';
  document.getElementById('step-crop').style.display = 'none';
  
  html5QrCode = new Html5Qrcode("reader");
  html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: 250 }, onBarcodeFound);
}

async function onBarcodeFound(code) {
  await html5QrCode.stop();
  tempProduct.barcode = code;
  
  document.getElementById('step-barcode').style.display = 'none';
  document.getElementById('loading').style.display = 'block';
  document.getElementById('modal-title').innerText = "Ürün Bulunuyor...";

  // API'den isim çek
  try {
    const res = await fetch(`https://world.openfoodfacts.org/api/v0/product/${code}.json`);
    const data = await res.json();
    tempProduct.name = (data.status === 1) ? (data.product.product_name_tr || data.product.product_name) : "Bilinmeyen Ürün";
  } catch { tempProduct.name = "Bilinmeyen Ürün"; }

  document.getElementById('loading').style.display = 'none';
  document.getElementById('modal-title').innerText = "Tarih Fotoğrafı Çek";
  document.getElementById('take-photo').click(); // Kamerayı aç
}

document.getElementById('take-photo').onchange = function(e) {
  const file = e.target.files[0];
  if(!file) return;
  
  const reader = new FileReader();
  reader.onload = function(event) {
    document.getElementById('step-crop').style.display = 'block';
    const img = document.getElementById('img-to-crop');
    img.src = event.target.result;
    
    if(cropper) cropper.destroy();
    cropper = new Cropper(img, { viewMode: 1, autoCropArea: 0.5 });
    document.getElementById('modal-title').innerText = "Tarihi Kırp";
  };
  reader.readAsDataURL(file);
};

async function finishOCR() {
  document.getElementById('loading').style.display = 'block';
  const canvas = cropper.getCroppedCanvas({ width: 600 });
  const base64 = canvas.toDataURL('image/jpeg');

  try {
    const result = await Tesseract.recognize(base64, 'eng+tur');
    const text = result.data.text;
    const dateMatch = text.match(/(\d{2}[.\/]\d{2}[.\/]\d{2,4})/);
    
    if(dateMatch) {
      tempProduct.date = dateMatch[0];
      saveProduct();
    } else {
      alert("Tarih okunamadı. Lütfen daha net bir seçim yapın.");
    }
  } catch(e) { alert("Hata: " + e.message); }
  document.getElementById('loading').style.display = 'none';
}

function saveProduct() {
  document.getElementById('empty-msg').style.display = 'none';
  const list = document.getElementById('product-list');
  const card = `
    <div class="card">
      <div>
        <strong>${tempProduct.name}</strong><br>
        <small style="color:#888">${tempProduct.barcode}</small>
      </div>
      <div style="color:var(--ok); font-weight:bold">${tempProduct.date}</div>
    </div>
  `;
  list.insertAdjacentHTML('afterbegin', card);
  closeAll();
}

function closeAll() {
  if(html5QrCode) try { html5QrCode.stop(); } catch(e){}
  document.getElementById('work-modal').style.display = 'none';
}
</script>
</body>
</html>
